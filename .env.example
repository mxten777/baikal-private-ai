# ===========================================
# BAIKAL Private AI - Environment Variables
# ===========================================
# ⚠️  이 파일을 .env로 복사한 후 반드시 아래 값들을 변경하세요.
#     기본값 그대로 사용 시 APP_ENV=production 환경에서 서버가 시작되지 않습니다.

# ---- PostgreSQL ----
POSTGRES_USER=baikal
# 반드시 변경하세요
POSTGRES_PASSWORD=YOUR_STRONG_DB_PASSWORD_HERE
POSTGRES_DB=baikal_ai
DATABASE_URL=postgresql+asyncpg://baikal:YOUR_STRONG_DB_PASSWORD_HERE@postgres:5432/baikal_ai

# ---- JWT ----
# 반드시 변경하세요 (생성 방법: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Ollama ----
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=qwen2.5:7b
EMBEDDING_MODEL=bge-m3

# ---- App ----
APP_ENV=production
DEFAULT_ADMIN_USERNAME=admin
# 반드시 변경하세요 (8자 이상, 영문+숫자+특수문자 조합 권장)
DEFAULT_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ---- Upload ----
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=100

# ---- RAG ----
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5
